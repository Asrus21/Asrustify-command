SPOTIFY_CLIENT_ID=Seu_Client_Id_Aqui
SPOTIFY_CLIENT_SECRET=Seu_Client_Secret_Aqui
REDIRECT_URI=https://asrus.app/spotify/callback
BASE_URL=https://asrus.app/spotify
# DATABASE_URL e injetada automaticamente ao conectar o Neon pela aba Storage da Vercel.
# Localmente, cole a connection string do seu banco Neon:
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Segredo compartilhado da rota POST /api/fila/:commandId.
# Sem ele a rota nega tudo: ela adiciona musica na fila do player.
FILA_SECRET=gere_um_valor_longo_e_aleatorio
# Segredo do comando !sr (GET /sr/:commandId?k=...). Separado do FILA_SECRET
# porque este viaja na URL do comando do bot. Sem ele, a rota nega tudo.
SR_SECRET=gere_outro_valor_longo_e_aleatorio
# Pagina /pedidos (Basic Auth). Sem os dois, a pagina nega tudo:
# ela mostra o e-mail de quem pediu acesso.
PEDIDOS_USER=seu_usuario
PEDIDOS_PASS=uma_senha_longa
# Quantas contas o Development Mode do Spotify aceita (o dashboard mostra "N/5").
# Fica aqui porque o Spotify ja mudou esse numero (25 -> 5 em fev/2026).
LIMITE_CONTAS=5

