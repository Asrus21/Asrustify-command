SPOTIFY_CLIENT_ID=Seu_Client_Id_Aqui
SPOTIFY_CLIENT_SECRET=Seu_Client_Secret_Aqui
REDIRECT_URI=https://asrus.app/spotify/callback
BASE_URL=https://asrus.app/spotify
# DATABASE_URL e injetada automaticamente ao conectar o Neon pela aba Storage da Vercel.
# Localmente, cole a connection string do seu banco Neon:
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Token do painel de solicitacoes de acesso (/admin/solicitacoes?token=...).
# Use um valor longo e aleatorio. Sem ele, o painel fica desativado.
ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio
